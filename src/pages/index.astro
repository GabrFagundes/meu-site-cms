---
import Layout from '../layouts/Layout.astro';
const posts = await Astro.glob('./blog/*.md');
// Ordena os posts por data mais recente
const sortedPosts = posts.sort((a, b) => Date.parse(b.frontmatter.pubDate) - Date.parse(a.frontmatter.pubDate));
---
<Layout title="Home - Meu Portal de Conteúdo">
    <div class="text-center max-w-2xl mx-auto mb-16">
        <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl mb-4">
            Gerencie Conteúdo de Forma <span class="text-indigo-600">Veloz</span>
        </h1>
        <p class="text-lg text-slate-600">
            Abaixo estão as publicações carregadas dinamicamente via Markdown e editáveis por interface gráfica.
        </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
        {sortedPosts.map(post => (
            <article class="bg-white border border-slate-100 rounded-2xl p-6 shadow-sm hover:shadow-md transition-all flex flex-col justify-between group">
                <div>
                    <div class="text-xs text-indigo-600 font-semibold uppercase tracking-wider mb-2">
                        {new Date(post.frontmatter.pubDate).toLocaleDateString('pt-BR', { dateStyle: 'long' })}
                    </div>
                    <h2 class="text-xl font-bold text-slate-900 group-hover:text-indigo-600 transition-colors mb-3">
                        {post.frontmatter.title}
                    </h2>
                    <p class="text-slate-600 text-sm leading-relaxed mb-6">
                        {post.frontmatter.description}
                    </p>
                </div>
                <a href={post.url} class="inline-flex items-center text-sm font-semibold text-indigo-600 hover:text-indigo-700 gap-1">
                    Ler artigo completo <span class="transform group-hover:translate-x-1 transition-transform">→</span>
                </a>
            </article>
        ))}
    </div>
</Layout>
